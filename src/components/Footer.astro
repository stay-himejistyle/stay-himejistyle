// フェーズ5（友だち集め設定）で発行される正式な短縮URL（lin.ee/...）に差し替え予定。
const lineAddFriendUrl = "https://line.me/R/ti/p/@309atmjy";

// Instagram公式アカウントは2026-07-02時点で未開設。
// 開設後、ここにアイコンリンクを追加する（TODO）。

const links = [
  { href: "/stays/", label: "宿一覧" },
  { href: "/articles/", label: "記事" },
  { href: "/about/", label: "About" },
  { href: "/editorial-policy/", label: "編集ポリシー" },
  { href: "/privacy-policy/", label: "プライバシーポリシー" },
