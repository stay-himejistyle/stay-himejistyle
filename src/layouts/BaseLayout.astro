---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "STAY HIMEJI by 姫路スタイル｜姫路の小さな宿のキュレーションメディア。周辺観光・グルメ・滞在モデルを編集して、各宿の体験価値を底上げします。",
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://stay.himejistyle.jp/";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="STAY HIMEJI by 姫路スタイル" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased font-sans">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
