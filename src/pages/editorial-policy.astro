---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("legal", "editorial-policy");
const { Content } = await render(entry);
---

<BaseLayout
  title="編集ポリシー | STAY HIMEJI by 姫路スタイル"
  description="STAY HIMEJI by 姫路スタイルの編集ポリシー。中立性の担保・取材プロセス・AI支援の利用方針などを公開しています。"
>
  <main class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="text-3xl font-bold text-stone-900">{entry.data.title}</h1>
    <p class="mt-2 text-sm text-stone-500">最終更新：{entry.data.lastUpdated}</p>
    <div class="prose prose-stone mt-8 max-w-none">
      <Content />
    </div>
  </main>
</BaseLayout>
