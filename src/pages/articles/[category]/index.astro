---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { categoryMeta } from "../../../lib/categories";
import { toSlug } from "../../../lib/slug";

export async function getStaticPaths() {
  return Object.keys(categoryMeta).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const meta = categoryMeta[category!];
const articles = await getCollection(
  "articles",
  ({ data }) => data.published && data.category === category && data.lang === "ja"
);
---

<BaseLayout
  title={`${meta.label} | STAY HIMEJI by 姫路スタイル`}
  description={meta.description}
>
  <main class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-3xl font-bold text-stone-900">{meta.label}</h1>
    <p class="mt-3 text-stone-600">{meta.description}</p>

    {articles.length === 0 ? (
      <p class="mt-10 text-stone-500">このカテゴリの記事は近日公開予定です。</p>
    ) : (
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <a href={`/articles/${category}/${toSlug(article.id)}/`} class="block rounded-lg border border-stone-200 bg-white p-4">
            <p class="font-bold text-stone-900">{article.data.title}</p>
          </a>
        ))}
      </div>
    )}

    <a href="/articles/" class="mt-10 inline-block text-sm text-stone-700 underline">
      ← 記事一覧に戻る
    </a>
  </main>
</BaseLayout>
