---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryMeta } from "../../lib/categories";

const categories = Object.entries(categoryMeta).map(([key, meta]) => ({ key, ...meta }));
---

<BaseLayout
  title="記事 | STAY HIMEJI by 姫路スタイル"
  description="姫路の食・泊・遊にまつわる編集記事の一覧です。"
>
  <main class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-3xl font-bold text-stone-900">姫路で泊まる時間を編む。</h1>
    <p class="mt-3 text-stone-600">記事は準備中です。カテゴリごとに近日公開予定です。</p>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {categories.map((cat) => (
        <a
          href={`/articles/${cat.key}/`}
          class="block rounded-lg border border-stone-200 bg-white p-6 transition hover:border-stone-300 hover:shadow-md"
        >
          <p class="text-xs text-stone-500">{cat.group}</p>
          <p class="mt-1 text-lg font-bold text-stone-900">{cat.label}</p>
          <p class="mt-2 text-sm text-stone-500">近日公開</p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
