---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import StayCard from "../components/StayCard.astro";

const stays = (await getCollection("stays", ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order
);

const lineAddFriendUrl = "https://line.me/R/ti/p/@309atmjy";

const categories = [
  {
    key: "食",
    title: "食",
    description: "朝食・夜の過ごし方など、姫路で泊まった人だけの楽しみ方。",
    href: "/articles/gourmet/",
  },
  {
    key: "泊",
    title: "泊",
    description: "5つの小さな宿の使い方・滞在モデルプラン。",
    href: "/articles/how-to-stay/",
  },
  {
    key: "遊",
    title: "遊",
    description: "城下町の歩き方・季節のイベント情報。",
    href: "/articles/sightseeing/",
  },
];
---

<BaseLayout
  title="STAY HIMEJI by 姫路スタイル | 姫路の小さな宿のキュレーションメディア"
  description="姫路の小さな宿のキュレーションメディア。周辺観光・グルメ・滞在モデルを編集して、各宿の体験価値を底上げします。"
>
  <main>
    <section class="mx-auto max-w-3xl px-6 py-24">
      <p class="text-xs tracking-[0.3em] text-stone-500 uppercase">
        Stay Himeji
      </p>
      <h1 class="mt-5 text-4xl font-bold tracking-tight text-stone-900 md:text-5xl">
        姫路城だけで帰るには、もったいない。
      </h1>
      <p class="mt-3 text-xl text-stone-700 leading-relaxed">
        個性豊かな小さな宿たちが、ここにある。
      </p>
      <p class="mt-8 text-stone-600 leading-relaxed">
        姫路駅周辺の小さな宿が集まる、滞在キュレーションメディア。<br class="hidden md:inline" />
        姫路の食・泊・遊を編集して、各宿の体験価値を底上げします。
      </p>
      <a
        href="#stays"
        class="mt-10 inline-block rounded-full border border-stone-400 px-6 py-3 text-sm text-stone-700 transition hover:border-stone-900 hover:text-stone-900"
      >
        姫路の小さな宿を見る ↓
      </a>
    </section>

    <section id="stays" class="border-t border-stone-200 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="text-2xl font-bold text-stone-900">姫路の小さな宿、5軒。</h2>
        <p class="mt-2 text-sm text-stone-500">並び順は準備中（正式な地理順は住所確定後に調整予定）</p>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {stays.map((stay) => (
            <StayCard stay={stay} />
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-stone-200">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class="text-2xl font-bold text-stone-900">姫路で泊まる時間を編む。</h2>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
          {categories.map((cat) => (
            <a
              href={cat.href}
              class="block rounded-lg border border-stone-200 bg-white p-6 transition hover:border-stone-300 hover:shadow-md"
            >
              <p class="text-3xl font-bold text-stone-900">{cat.title}</p>
              <p class="mt-2 text-sm text-stone-600 leading-relaxed">
                {cat.description}
              </p>
            </a>
          ))}
        </div>
        <p class="mt-6 text-sm text-stone-500">記事は近日公開予定です。</p>
      </div>
    </section>

    <section class="border-t border-stone-200 bg-white">
      <div class="mx-auto max-w-3xl px-6 py-16 text-center">
        <h2 class="text-xl font-bold text-stone-900">
          友だち追加で、新着記事とお得な情報を。
        </h2>
        <p class="mt-2 text-sm text-stone-600">
          5つの宿への予約・お問い合わせ窓口としてもご利用いただけます。
        </p>
        <a
          href={lineAddFriendUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-[#06C755] px-6 py-3 text-sm font-medium text-white transition hover:opacity-90"
        >
          LINE友だち追加
        </a>
      </div>
    </section>

    <section class="border-t border-stone-200">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2 class="text-xl font-bold text-stone-900">この媒体について</h2>
        <p class="mt-4 text-stone-600 leading-relaxed">
          STAY HIMEJI by 姫路スタイル は、姫路の小さな宿を横断的に紹介するキュレーションメディアです。
          コワーキングスペース「姫路スタイル」を運営する福永友香が媒体監修を務め、
          福永義正・福永拓光が編集にあたっています。
        </p>
        <a href="/about/" class="mt-4 inline-block text-sm text-stone-700 underline">
          もっと読む →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
